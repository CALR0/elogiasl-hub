{
  "name": "soporte-elogiasl",
  "version": "0.1.0",
  "private": true,
  "description": "Plataforma integrada de Elogia Soluciones Logísticas (Despacho, Financiero, Maestros, Estudios, Auditoría y Configuración)",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "type-check": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:types": "supabase gen types typescript --linked > lib/supabase/database.types.ts",
    "db:push": "supabase db push",
    "db:test": "node scripts/test-rls.mjs",
    "test:fichas": "node --experimental-strip-types --no-warnings scripts/probar-fichas.ts",
    "probar:waf": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/probar-waf.mjs",
    "test:anticipos": "node --experimental-strip-types --no-warnings scripts/probar-anticipos.ts",
    "probar:sicetac": "node --experimental-strip-types --no-warnings scripts/probar-sicetac.ts",
    "test:sicetac": "node --experimental-strip-types --no-warnings scripts/probar-sicetac-xml.ts",
    "test:cumplidos": "node --experimental-strip-types --no-warnings scripts/probar-cumplidos.ts",
    "test:estudios": "node --conditions=react-server --experimental-strip-types --no-warnings scripts/probar-estudios.ts"
  },
  "dependencies": {
    "@sparticuz/chromium": "^153.0.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "cheerio": "^1.2.0",
    "domhandler": "^5.0.3",
    "lucide-react": "^1.61.0",
    "next": "16.4.3",
    "pdfkit": "^0.15.2",
    "puppeteer-core": "^25.15.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "xlsx-js-style": "^1.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.14",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/pdfkit": "^0.17.7",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "supabase": "^2.122.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
