# Copia este archivo a .env.local y completa los valores.
# Solo las variables NEXT_PUBLIC_* llegan al navegador. El resto es server-only.
# Sin las variables de Supabase, `npm run dev` arranca en MODO DEMOSTRACIÓN
# (usuario de ejemplo con acceso total, sin BD).

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Minutos de inactividad antes de cerrar la sesión (1–240). Por defecto 30.
NEXT_PUBLIC_INACTIVIDAD_MINUTOS=30

# Supabase (Project Settings → API Keys)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...          # Ignora RLS. NUNCA al cliente.

# Cifra la sesión de Silogtran guardada en Supabase y las fichas consultadas.
# Obligatoria en producción (≥32 caracteres). Genera con:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Silogtran — cuenta de servicio (Maestros › Vehículo › Generar ficha técnica)
# Obligatorias para Generar ficha técnica (también en Vercel).
SILOG_BASE_URL=https://construproyec.colombiasoftware.net/
SILOG_USUARIO=
SILOG_CLAVE=
SILOG_CENTRO_COSTO=              # opcional: código o nombre; si no, el primero disponible
# Protección de la cuenta compartida (opcionales)
SILOG_LOGIN_MAX_HORA=4
SILOG_LOGIN_MAX_DIA=20

# AWS WAF de Silogtran: en Vercel se usa @sparticuz/chromium automáticamente.
# En local (Windows) indica tu Chrome:
WAF_CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
WAF_ESPERA_SEG=30

# Financiero › Transferencia › Migración anticipo SAP
# Llave SECRETA del API de AWS (POST /events). Sin ella, el envío a SAP queda
# en modo simulado (consulta Silogtran pero no crea anticipos).
X_API_KEY=
# true = fuerza el modo simulado aunque haya llave (para pruebas)
SIMULATE_CREATE=false
AWS_API_BASE=https://uss5a626ei.execute-api.sa-east-1.amazonaws.com/prod
# Interfaz del Log de Silogtran donde están los payloads (opcionales)
SILOG_INTERFAZ_ID=139
SILOG_INTERFAZ_TEXTO=QAS DAABON OC SAP
SILOG_LOG_FECHA_INI=2026-01-01
SILOG_LOG_FECHA_FIN=2030-01-01

# Despacho › Tráfico › Monitoreo vehículo — Control T (monitoreo de flotas)
# Cuenta de servicio del API Public de Control T (login JSON en /apipublic/api/login/oauth).
# Sin estas variables el módulo responde "no está configurado".
CONTROLT_BASE_URL=https://app.controlt.com.co
CONTROLT_USUARIO=
CONTROLT_CLAVE=

# Estudios — TusDatos (consulta de antecedentes)
# Mientras no haya credenciales, las solicitudes se procesan en MODO SIMULADO
# (fuentes y hallazgos deterministas, sin gastar créditos ni salir a internet).
# Cuando la integración real quede migrada se usarán estas variables.
TUSDATOS_USUARIO=
TUSDATOS_CLAVE=

# Despacho › Manifiesto › Expedir manifiesto SICETAC — web service RNDC del Ministerio
# Se usan para consultar si un manifiesto ya tiene radicado. Si no se definen, se
# toman del XML del intento rechazado (pero los manifiestos radicados de antes no
# traen XML y no se podrían verificar).
RNDC_USUARIO=
RNDC_CLAVE=
RNDC_NIT=8190041165
